<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.zink.renderprobe">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
  <queries><package android:name="com.hp.impulse.sprocket" /></queries>
  <!-- Deliberately no permissions: no Bluetooth, network, camera, or shared storage. -->
